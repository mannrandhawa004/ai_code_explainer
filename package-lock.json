      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@codebase-explainer/worker": {
      "resolved": "apps/worker",
      "link": true
    },
    "packages/database": {
      "name": "@codebase-explainer/database",
      "version": "0.1.0"
    },
    "packages/eslint-config": {
      "name": "@codebase-explainer/eslint-config",
      "version": "0.1.0"
    },
    "packages/shared": {
      "name": "@codebase-explainer/shared",
      "version": "0.1.0"
    }
  }
