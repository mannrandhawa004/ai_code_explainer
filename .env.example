# Application
NODE_ENV=development
API_PORT=5000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
LOG_LEVEL=info
API_JSON_LIMIT=1mb
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100

# Optional Docker Compose host ports. Change these when a local service already
# occupies a default port; container-to-container ports remain unchanged.
CODEBASE_EXPLAINER_API_PORT=5000
CODEBASE_EXPLAINER_MONGODB_PORT=27017
CODEBASE_EXPLAINER_REDIS_PORT=6379
CODEBASE_EXPLAINER_QDRANT_HTTP_PORT=6333
CODEBASE_EXPLAINER_QDRANT_GRPC_PORT=6334

# MongoDB
# Production requires mongodb+srv:// or a mongodb:// URI with tls=true.
MONGODB_URI=mongodb://localhost:27017/codebase_explainer
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Redis
# Production requires a managed TLS endpoint using rediss://.
REDIS_URL=redis://localhost:6379

# AI provider
# "google" avoids local model resource usage and supports a Gemini API free
# tier. "openai" and "ollama" remain optional alternatives.
AI_PROVIDER=google

# Google Gemini (recommended for lightweight development)
# Create a key in Google AI Studio and keep it server-side only. GOOGLE_API_KEY
# takes precedence when both supported key variables are configured.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_EMBEDDING_DIMENSIONS=768
GOOGLE_CHAT_MODEL=gemini-2.5-flash-lite
GOOGLE_REQUEST_TIMEOUT_MS=120000
GOOGLE_ANSWER_MAX_OUTPUT_TOKENS=2000
GOOGLE_MAX_CONTEXT_CHARACTERS=60000
GOOGLE_MAX_HISTORY_CHARACTERS=12000
GOOGLE_EMBEDDING_BATCH_SIZE=16
GOOGLE_EMBEDDING_REQUEST_CONCURRENCY=1
GOOGLE_EMBEDDING_MAX_INPUT_TOKENS=8192
GOOGLE_EMBEDDING_MAX_REQUEST_TOKENS=65536

# Ollama (optional low-resource local profile)
# OLLAMA_URL is used when API/worker run directly on Windows. Compose overrides
# it with OLLAMA_DOCKER_URL so containers can reach the Windows host service.
OLLAMA_URL=http://localhost:11434
OLLAMA_DOCKER_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_DIMENSIONS=1024
OLLAMA_CHAT_MODEL=qwen2.5-coder:0.5b
OLLAMA_REQUEST_TIMEOUT_MS=300000
OLLAMA_KEEP_ALIVE=2m
OLLAMA_CONTEXT_TOKENS=4096
OLLAMA_ANSWER_MAX_OUTPUT_TOKENS=800
OLLAMA_MAX_CONTEXT_CHARACTERS=12000
OLLAMA_MAX_HISTORY_CHARACTERS=3000
OLLAMA_EMBEDDING_BATCH_SIZE=4
OLLAMA_EMBEDDING_REQUEST_CONCURRENCY=1
OLLAMA_EMBEDDING_MAX_INPUT_TOKENS=2048
OLLAMA_EMBEDDING_MAX_REQUEST_TOKENS=8192

# OpenAI (optional paid alternative)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_REQUEST_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=3
OPENAI_ANSWER_MAX_OUTPUT_TOKENS=4000
OPENAI_MAX_CONTEXT_CHARACTERS=60000
OPENAI_MAX_HISTORY_CHARACTERS=12000

# Qdrant
# Production requires an https:// endpoint and QDRANT_API_KEY.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Use a new collection whenever the embedding model or dimensions change.
QDRANT_COLLECTION=code_chunks_google_768
QDRANT_VECTOR_SIZE=768
QDRANT_REQUEST_TIMEOUT_MS=5000
QUESTION_SEARCH_LIMIT=15
QUESTION_SCORE_THRESHOLD=

# GitHub App
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Store PEM line breaks as literal \n sequences when the platform requires one line.
GITHUB_PRIVATE_KEY=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
# Use the same high-entropy value configured in the GitHub App webhook settings.
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_BODY_LIMIT=5mb
GITHUB_WEBHOOK_ENQUEUE_TIMEOUT_MS=5000

# Authentication and encryption
# Use at least 32 random characters. Rotating this signs all users out.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=604800
COOKIE_NAME=codebase_explainer_session
OAUTH_STATE_COOKIE_NAME=codebase_explainer_oauth_state
OAUTH_STATE_TTL_SECONDS=600
# Rotating this requires users to authorize GitHub again.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Repository limits
MAX_REPOSITORY_SIZE_MB=100
MAX_REPOSITORY_FILES=5000
MAX_FILE_SIZE_KB=500

# Indexing
INDEXING_MAX_ATTEMPTS=1
EMBEDDING_BATCH_SIZE=50
EMBEDDING_REQUEST_CONCURRENCY=2
EMBEDDING_MAX_INPUT_TOKENS=8192
EMBEDDING_MAX_REQUEST_TOKENS=290000
INDEXING_CONCURRENCY=1
GITHUB_WEBHOOK_CONCURRENCY=1
WORKER_SHUTDOWN_TIMEOUT_MS=30000
TEMP_REPOSITORY_DIR=./tmp/codebase-explainer
REPOSITORY_CLONE_TIMEOUT_MS=120000
MAX_REPOSITORY_SCAN_ENTRIES=100000
MAX_REPOSITORY_DEPTH=64
LINE_CHUNK_SIZE=120
LINE_CHUNK_OVERLAP=20
MAX_SOURCE_CHARACTERS=104857600
MAX_REPOSITORY_CHUNKS=100000
