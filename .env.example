# Application
NODE_ENV=development
API_PORT=5000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000
LOG_LEVEL=info
API_JSON_LIMIT=1mb
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100

# MongoDB
MONGODB_URI=mongodb://localhost:27017/codebase_explainer
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=code_chunks

# GitHub App
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Authentication and encryption
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=codebase_explainer_session
ENCRYPTION_KEY=

# Repository limits
MAX_REPOSITORY_SIZE_MB=100
MAX_REPOSITORY_FILES=5000
MAX_FILE_SIZE_KB=500

# Indexing
EMBEDDING_BATCH_SIZE=50
INDEXING_CONCURRENCY=5
TEMP_REPOSITORY_DIR=./tmp/codebase-explainer
